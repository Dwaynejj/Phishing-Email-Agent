{
  "manifest_version": 3,
  "name": "PhishShield Email Detector",
  "version": "1.1",
  "description": "Detects phishing emails in Gmail using the local PhishShield API",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://127.0.0.1:5001/*",
    "http://localhost:5001/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishShield"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
